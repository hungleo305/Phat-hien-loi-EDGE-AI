es_proc" target="d_gate" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=20;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1080" y="1005" /><mxPoint x="490" y="1005" /></Array></mxGeometry></mxCell><mxCell id="e14" parent="1" edge="1" source="d_res" target="d_gate" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=20;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e15" parent="1" edge="1" source="d_gate" target="loop" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=20;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="60" y="1092" /><mxPoint x="60" y="441" /></Array></mxGeometry></mxCell><mxCell id="e16" parent="1" edge="1" source="d_gate" target="d_ready" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=20;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e17" parent="1" edge="1" source="d_ready" target="wait_res" value="Chưa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=20;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e18" parent="1" edge="1" source="wait_res" target="d_defect" value="Khi có kết quả" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=20;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1080" y="1345" /><mxPoint x="490" y="1345" /></Array></mxGeometry></mxCell><mxCell id="e19" parent="1" edge="1" source="d_ready" target="d_defect" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=20;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e20" parent="1" edge="1" source="d_defect" target="act_reject" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=20;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e21" parent="1" edge="1" source="d_defect" target="act_pass" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=20;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1080" y="1432" /></Array></mxGeometry></mxCell><mxCell id="e22" parent="1" edge="1" source="act_reject" target="done_box" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=20;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e23" parent="1" edge="1" source="act_pass" target="done_box" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=20;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1080" y="1656" /><mxPoint x="490" y="1656" /></Array></mxGeometry></mxCell><mxCell id="e24" parent="1" edge="1" source="done_box" target="loop" value="Lặp lại" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=20;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="60" y="1729" /><mxPoint x="60" y="441" /></Array></mxGeometry></mxCell><mxCell id="start" parent="1" vertex="1" value="Bắt đầu: Khởi tạo ESP32, UART2,&lt;br&gt;cảm biến, PWM motor và servo" style="shape=rectangle;rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=22;"><mxGeometry x="210" y="25" width="560" height="68" as="geometry" /></mxCell><mxCell id="stopped" parent="1" vertex="1" value="Trạng thái STOPPED: Dừng băng tải,&lt;br&gt;xóa FIFO, đưa servo về vị trí 0° (Home)" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=22;"><mxGeometry x="210" y="128" width="560" height="82" as="geometry" /></mxCell><mxCell id="d_start" parent="1" vertex="1" value="Nhận lệnh START hợp lệ?&lt;br&gt;(Pi READY, cảm biến trống)" style="shape=rhombus;rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=21;"><mxGeometry x="210" y="245" width="560" height="114" as="geometry" /></mxCell><mxCell id="loop" parent="1" vertex="1" value="Vòng quét điều khiển (chu kỳ 10 ms):&lt;br&gt;Đọc 2 cảm biến (lọc 30 ms), nhận UART2,&lt;br&gt;cập nhật các pha servo và bộ định thời" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=22;"><mxGeometry x="210" y="395" width="560" height="96" as="geometry" /></mxCell><mxCell id="d_fault" parent="1" vertex="1" value="Phát sinh lỗi theo dõi,&lt;br&gt;ERROR hoặc quá hạn chờ?" style="shape=rhombus;rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=21;"><mxGeometry x="210" y="522" width="560" height="114" as="geometry" /></mxCell><mxCell id="fault" parent="1" vertex="1" value="Trạng thái FAULT: Dừng băng tải,&lt;br&gt;giữ nguyên tay gạt, báo lỗi về Pi" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=22;"><mxGeometry x="850" y="533" width="460" height="92" as="geometry" /></mxCell><mxCell id="recover" parent="1" vertex="1" value="Người vận hành dọn hết hộp;&lt;br&gt;gửi lệnh STOP để khôi phục" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=22;"><mxGeometry x="850" y="365" width="460" height="95" as="geometry" /></mxCell><mxCell id="d_cam" parent="1" vertex="1" value="Cảm biến chụp phát hiện&lt;br&gt;hộp mới vào buồng chụp?" style="shape=rhombus;rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=21;"><mxGeometry x="210" y="675" width="560" height="114" as="geometry" /></mxCell><mxCell id="cap_proc" parent="1" vertex="1" value="Cấp ID, đẩy vào FIFO, dừng ổn định;&lt;br&gt;gửi CAPTURE, chờ CAPTURED&lt;br&gt;hợp lệ rồi bật lại băng tải (*)" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=22;"><mxGeometry x="850" y="682" width="460" height="100" as="geometry" /></mxCell><mxCell id="d_res" parent="1" vertex="1" value="Nhận bản tin RESULT&lt;br&gt;hợp lệ từ Raspberry Pi?" style="shape=rhombus;rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=21;"><mxGeometry x="210" y="855" width="560" height="114" as="geometry" /></mxCell><mxCell id="res_proc" parent="1" vertex="1" value="Lưu kết quả PASS / DEFECT&lt;br&gt;vào đúng ID hộp trong FIFO" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=22;"><mxGeometry x="850" y="867" width="460" height="90" as="geometry" /></mxCell><mxCell id="d_gate" parent="1" vertex="1" value="Cảm biến cửa gạt phát hiện&lt;br&gt;hộp đầu hàng đợi FIFO?" style="shape=rhombus;rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=21;"><mxGeometry x="210" y="1035" width="560" height="114" as="geometry" /></mxCell><mxCell id="d_ready" parent="1" vertex="1" value="Hộp đầu FIFO đã có&lt;br&gt;kết quả kiểm định AI?" style="shape=rhombus;rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=21;"><mxGeometry x="210" y="1195" width="560" height="114" as="geometry" /></mxCell><mxCell id="wait_res" parent="1" vertex="1" value="Dừng băng tải tại cửa gạt chờ kết quả;&lt;br&gt;tiếp tục giám sát hạn chờ" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=22;"><mxGeometry x="850" y="1207" width="460" height="90" as="geometry" /></mxCell><mxCell id="d_defect" parent="1" vertex="1" value="Kết quả là DEFECT và&lt;br&gt;bật chế độ gạt (SORT)?" style="shape=rhombus;rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=21;"><mxGeometry x="210" y="1375" width="560" height="114" as="geometry" /></mxCell><mxCell id="act_reject" parent="1" vertex="1" value="Quay servo gạt hộp lỗi (0° → 60°,&lt;br&gt;giữ 350 ms) rồi thu tay gạt về 0°" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=22;"><mxGeometry x="210" y="1540" width="560" height="88" as="geometry" /></mxCell><mxCell id="act_pass" parent="1" vertex="1" value="Giữ nguyên servo ở 0°,&lt;br&gt;cho hộp đi thẳng qua cửa gạt" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=22;"><mxGeometry x="850" y="1540" width="460" height="88" as="geometry" /></mxCell><mxCell id="done_box" parent="1" vertex="1" value="Chờ cảm biến cửa gạt nhả và servo về 0°;&lt;br&gt;báo DONE, xóa hộp đầu khỏi FIFO" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=22;"><mxGeometry x="210" y="1685" width="560" height="88" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>